---
import { Image } from 'astro:assets';
import { SITE } from '../data/site.ts';
import dgMark from '../assets/branding/dg-mark.png';

const links = [
  { href: '/listings', label: 'Listings' },
  { href: '/sell', label: 'Sell' },
  { href: '/home-valuation', label: 'Home Value' },
  { href: '/mortgage-calculator', label: 'Calculators' },
  { href: '/areas', label: 'Areas' },
  { href: '/about', label: 'About' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <Image src={dgMark} alt="" width={34} densities={[1, 2]} loading="eager" class="brand__mark" />
      <span class="brand__text">
        <b class="brand__name">Derrick <span>Garcia</span></b>
        <em class="brand__sub">Real Broker Ontario</em>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}
        <li><a class="tel" href={SITE.phoneHref}>416-684-7370</a></li>
        <li><a class="book" href="/contact">Book a Call</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector('.site-header')!;
  const btn = header.querySelector('.nav-toggle') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const open = header.classList.toggle('nav-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('nav-open')) {
      header.classList.remove('nav-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.focus(); // restore focus to the toggle (WCAG 2.4.3) when closing the mobile overlay
    }
  });
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent;
    transition: background .3s ease, border-color .3s ease; }
  .site-header.is-scrolled { background: rgba(12, 12, 14, .82);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--hair); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding-block: .85rem; }

  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; white-space: nowrap; }
  .brand__mark { width: 34px; height: auto; display: block; }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name { font-family: var(--font-display); font-weight: 400; font-size: 1.12rem;
    color: var(--color-ink); letter-spacing: .02em; }
  .brand__name span { color: var(--color-accent); }
  .brand__sub { font-family: var(--font-ui); font-style: normal; font-size: .58rem;
    letter-spacing: .2em; text-transform: uppercase; color: var(--color-muted); margin-top: 3px; }

  .site-nav ul { display: flex; gap: 1.35rem; align-items: center; list-style: none; margin: 0; padding: 0; }
  .nav-link { font-family: var(--font-ui); font-size: .84rem; color: var(--color-text);
    text-decoration: none; letter-spacing: .01em; }
  .nav-link:hover { color: var(--color-accent); }
  .tel { font-family: var(--font-ui); color: var(--color-accent); font-weight: 600; text-decoration: none; }
  .book { font-family: var(--font-ui); background: var(--color-accent); color: var(--color-accent-ink);
    padding: .55rem 1.05rem; border-radius: 2px; font-size: .74rem; letter-spacing: .06em;
    text-transform: uppercase; font-weight: 600; text-decoration: none; transition: background .2s ease; }
  .book:hover { background: var(--color-accent-bright); }

  .nav-toggle { display: none; background: none; border: 1px solid var(--color-line);
    border-radius: var(--radius); padding: .55rem .65rem; cursor: pointer; }
  .nav-toggle__bar { display: block; width: 1.2rem; height: 2px; background: var(--color-ink);
    box-shadow: 0 -5px 0 var(--color-ink), 0 5px 0 var(--color-ink); }

  @media (max-width: 920px) {
    .nav-toggle { display: block; }
    .site-nav { display: none; }
    .nav-open .site-nav { display: block; position: fixed; inset: 3.6rem 0 0 0;
      background: var(--color-bg); overflow-y: auto; padding: 1.5rem; z-index: 49; }
    .nav-open .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-open .site-nav li { border-bottom: 1px solid var(--color-line); }
    .nav-open .nav-link, .nav-open .tel { display: block; padding: 1rem .2rem; font-size: 1.05rem; }
    .nav-open .book { display: inline-block; margin-top: 1rem; }
  }
</style>
