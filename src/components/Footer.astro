---
import { Image } from 'astro:assets';
import { SITE } from '../data/site.ts';
import realWordmark from '../assets/branding/real-wordmark-white.png';
import dgLogo from '../assets/branding/dg-logo-text-light.png';
---
<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="fbrand">
        <Image src={dgLogo} alt="Derrick Garcia" width={170} class="flogo" />
        <p class="nap">{SITE.brokerage}<br />{SITE.address.street}<br />
          {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}</p>
        <p class="nap"><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <Image src={realWordmark} alt="Real Broker" width={96} class="wordmark" />
      </div>
      <nav aria-label="Explore">
        <h2>Explore</h2>
        <a href="/listings">Listings</a>
        <a href="/sell">Sell My Home</a>
        <a href="/home-valuation">Home Valuation</a>
        <a href="/rent-to-own">Rent to Own</a>
        <a href="/deposit-lending">Deposit Lending</a>
        <a href="/reviews">Reviews</a>
      </nav>
      <nav aria-label="Tools">
        <h2>Tools</h2>
        <a href="/mortgage-calculator">Mortgage Calculator</a>
        <a href="/affordability-calculator">Affordability Calculator</a>
        <a href="/land-transfer-tax">Land Transfer Tax</a>
        <a href="/guides">Guides</a>
      </nav>
      <nav aria-label="Areas">
        <h2>Areas</h2>
        <a href="/areas/caledon">Caledon</a>
        <a href="/areas/bolton">Bolton</a>
        <a href="/areas/orangeville">Orangeville</a>
        <a href="/areas/brampton">Brampton</a>
        <a href="/areas/mississauga">Mississauga</a>
        <a href="/areas">All Areas</a>
      </nav>
      <nav aria-label="Connect">
        <h2>Connect</h2>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="/contact">Book a Call</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div class="legal">
      <p class="tm">The trademarks REALTOR®, REALTORS®, and the REALTOR® logo are controlled by
        The Canadian Real Estate Association (CREA) and identify real estate professionals who are
        members of CREA. The trademarks MLS®, Multiple Listing Service® and the associated logos
        identify professional services rendered by REALTOR® members of CREA. Listing data is
        provided under CREA's Data Distribution Facility (DDF®) — Powered by REALTOR.ca.</p>
      <div class="legal__row">
        <span>© {new Date().getFullYear()} {SITE.legalName}. Not intended to solicit buyers or sellers currently under contract.</span>
        <span><a href="/privacy">Privacy</a> · <a href="/accessibility">Accessibility</a></span>
      </div>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-line); background: var(--color-bg-2);
    margin-top: var(--section-pad); padding-block: 3.2rem 1.8rem; }
  .grid { display: grid; gap: 2rem; grid-template-columns: 1.4fr repeat(4, 1fr); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
  .fbrand .flogo { height: 56px; width: auto; margin-bottom: 1rem; }
  .nap { font-size: .85rem; line-height: 1.9; margin: 0 0 .8rem; color: var(--color-muted); }
  .nap a { color: var(--color-text); text-decoration: none; }
  .nap a:hover { color: var(--color-accent); }
  .wordmark { opacity: .7; margin-top: .4rem; }
  .site-footer nav { display: flex; flex-direction: column; gap: .5rem; }
  .site-footer nav h2 { font-family: var(--font-ui); color: var(--color-accent);
    font-size: .68rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; margin: 0 0 .6rem; }
  .site-footer nav a { color: var(--color-text); text-decoration: none; font-size: .88rem; }
  .site-footer nav a:hover { color: var(--color-accent); }
  .legal { border-top: 1px solid var(--hair); margin-top: 2.4rem; padding-top: 1.4rem;
    color: var(--color-muted); font-size: .74rem; }
  .legal .tm { max-width: 100ch; line-height: 1.5; margin: 0 0 1rem; }
  .legal__row { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .legal a { color: var(--color-muted); }
  .legal a:hover { color: var(--color-accent); }
</style>
