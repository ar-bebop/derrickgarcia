---
// CREA-required "Powered by REALTOR.ca" attribution badge for displayed DDF listings.
// Official CREA asset served as a STATIC file from public/ (native 125x60). It's referenced
// by a short path rather than imported, because this renders on every listing card — letting
// Vite inline it as a data URI would repeat the whole SVG on each card (≈1.9MB hub HTML).
// One cached file is far lighter. (Hotlinking www.realtor.ca is WAF-blocked anyway.)
// DDF rule: badge links to the specific listing on REALTOR.ca; displayed unmodified, >=90px wide.
import { SITE } from '../data/site.ts';
const { url } = Astro.props as { url: string | null };
const href = url ?? SITE.listingsSearchUrl;
---
<a class="pbr" href={href} target="_blank" rel="noopener noreferrer"
   aria-label="View this listing on REALTOR.ca">
  <img class="pbr__logo" src="/powered-by-realtor.svg" width="125" height="60"
       loading="lazy" decoding="async" alt="Powered by REALTOR.ca" />
</a>
<style>
  .pbr { display: inline-block; line-height: 0; }
  .pbr__logo { width: 125px; max-width: 100%; height: auto; display: block; }
</style>
