---
// Live homepage mortgage estimate — Canadian semi-annual compounding via the tested math module.
---
<section class="section mm">
  <div class="container">
    <div class="mm__head"><p class="kicker">Know your numbers</p><h2>Plan your purchase — right here.</h2></div>
    <div class="mm__grid">
      <div class="mm__calc">
        <h3>Mortgage payment</h3>
        <div class="mm__row"><label for="mm-price">Home price</label>
          <input id="mm-price" type="range" min="300000" max="2500000" step="10000" value="850000">
          <span class="mm__v ui" id="mm-price-v">$850,000</span></div>
        <div class="mm__row"><label for="mm-dp">Down payment</label>
          <input id="mm-dp" type="range" min="5" max="50" step="1" value="20">
          <span class="mm__v ui" id="mm-dp-v">20%</span></div>
        <div class="mm__row"><label for="mm-rate">Rate</label>
          <input id="mm-rate" type="range" min="2" max="8" step="0.05" value="4.79">
          <span class="mm__v ui" id="mm-rate-v">4.79%</span></div>
        <div class="mm__row"><label for="mm-amort">Amortization</label>
          <input id="mm-amort" type="range" min="5" max="30" step="5" value="25">
          <span class="mm__v ui" id="mm-amort-v">25 yrs</span></div>
        <div class="mm__result"><span class="ui">Est. monthly</span><span class="mm__out" id="mm-out">$0</span></div>
        <p class="mm__note ui" id="mm-note"></p>
      </div>
      <div class="mm__links">
        <a class="mm__link" href="/affordability-calculator"><span><b>Affordability calculator</b><span>What price can you carry? GDS/TDS + stress test.</span></span><span class="ar">→</span></a>
        <a class="mm__link" href="/land-transfer-tax"><span><b>Land transfer tax</b><span>Ontario + Toronto LTT, with first-time rebates.</span></span><span class="ar">→</span></a>
        <a class="mm__link" href="/rent-to-own"><span><b>Rent-to-own readiness</b><span>Not mortgage-ready yet? See the path.</span></span><span class="ar">→</span></a>
        <a class="mm__link" href="/deposit-lending"><span><b>Deposit lending</b><span>Bridge your deposit before closing.</span></span><span class="ar">→</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .mm__head { margin-bottom: 1.6rem; }
  .mm__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  @media (max-width: 840px) { .mm__grid { grid-template-columns: 1fr; } }
  .mm__calc { background: var(--color-panel); border: 1px solid var(--color-line-strong); border-radius: var(--radius); padding: 1.6rem; }
  .mm__calc h3 { font-size: 1.3rem; margin: 0 0 1rem; }
  .mm__row { display: flex; align-items: center; gap: 1rem; margin: .9rem 0; }
  .mm__row label { font-family: var(--font-ui); font-size: .78rem; color: var(--color-text); min-width: 110px; }
  .mm__row input[type=range] { flex: 1; accent-color: var(--color-accent); }
  .mm__v { color: var(--color-ink); font-size: .85rem; min-width: 96px; text-align: right; }
  .mm__result { display: flex; align-items: baseline; justify-content: space-between; margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--hair); }
  .mm__result .ui { color: var(--color-muted); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
  .mm__out { font-family: var(--font-display); color: var(--color-accent-bright); font-size: 2.2rem; line-height: 1; }
  .mm__note { font-size: .72rem; color: var(--color-muted); margin: .7rem 0 0; }
  .mm__links { display: flex; flex-direction: column; gap: .8rem; }
  .mm__link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.05rem 1.3rem;
    border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-panel); transition: all .2s ease; }
  .mm__link:hover { border-color: var(--color-accent); transform: translateX(4px); }
  .mm__link b { font-family: var(--font-display); color: var(--color-ink); font-weight: 400; font-size: 1.05rem; display: block; }
  .mm__link span span, .mm__link > span > span { font-size: .82rem; color: var(--color-muted); }
  .mm__link .ar { color: var(--color-accent); font-size: 1.1rem; }
</style>
<script>
  import { payment } from '../../lib/mortgage-math.js';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const out = document.getElementById('mm-out'), note = document.getElementById('mm-note');
  if (out && note && $('mm-price')) {
    const f = (n: number) => '$' + Math.round(n).toLocaleString();
    function calc() {
      const price = +$('mm-price').value, dp = +$('mm-dp').value, rate = +$('mm-rate').value, amort = +$('mm-amort').value;
      const principal = price * (1 - dp / 100);
      const monthly = payment(principal, rate / 100, amort, 12);
      $('mm-price-v').textContent = f(price);
      $('mm-dp-v').textContent = dp + '% · ' + f(price * dp / 100);
      $('mm-rate-v').textContent = rate.toFixed(2) + '%';
      $('mm-amort-v').textContent = amort + ' yrs';
      out!.textContent = f(monthly) + '/mo';
      note!.textContent = `On ${f(principal)} financed at ${rate.toFixed(2)}% over ${amort} years${dp < 20 ? ' · CMHC insurance applies under 20% down' : ''}.`;
    }
    ['mm-price', 'mm-dp', 'mm-rate', 'mm-amort'].forEach((id) => $(id).addEventListener('input', calc));
    calc();
  }
</script>
