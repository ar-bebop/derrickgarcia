---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DerrickListings from '../../components/DerrickListings.astro';
import ListingsBrowser from '../../components/listings/ListingsBrowser.astro';
import PoweredByRealtor from '../../components/PoweredByRealtor.astro';
import { IN_MARKETS } from '../../data/listings.ts';
import { SITE } from '../../data/site.ts';

const hasListings = IN_MARKETS.length > 0;
---
<BaseLayout title="Homes for Sale Across the GTA — Derrick Garcia | Real Broker Ontario"
  description="Browse every Real Broker Ontario listing across Toronto and the GTA. Filter by area, price and type, or explore the interactive map.">
  <section class="head container">
    <p class="kicker">Listings · Real Broker Ontario</p>
    <h1>Homes for sale across the GTA</h1>
    <p class="dek">Every Real Broker Ontario listing in Derrick's markets, in one place — filter, sort, or explore the map.</p>
  </section>

  <DerrickListings />

  <section class="container body">
    {hasListings ? (
      <>
        <ListingsBrowser />
        <div class="compliance">
          <PoweredByRealtor url={null} />
          <p class="compliance__tm">Listings provided by <b>Real Broker Ontario LTD.</b> via CREA's DDF®.
            Photos are displayed unmodified from REALTOR.ca.</p>
        </div>
      </>
    ) : (
      <div class="empty">
        <p>Our live listings feed is temporarily unavailable. You can search every active GTA listing
          on REALTOR.ca, or get in touch and we'll send you matches by hand.</p>
        <p class="ctas btn-row">
          <a class="btn" href={SITE.listingsSearchUrl} target="_blank" rel="noopener noreferrer">Search realtor.ca ↗</a>
          <a class="btn btn--ghost" href="/contact">Get in Touch</a>
        </p>
      </div>
    )}
  </section>
</BaseLayout>
<style>
  .head { padding-block: clamp(2.5rem, 7vw, 4rem) 1rem; }
  .dek { max-width: 60ch; font-size: 1.05rem; color: var(--color-muted); }
  .body { padding-bottom: var(--section-pad); }
  .compliance { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap;
    margin-top: 2.4rem; padding-top: 1.4rem; border-top: 1px solid var(--hair); }
  .compliance__tm { font-size: .8rem; color: var(--color-muted); max-width: 70ch; }
  .empty { max-width: 56ch; font-size: 1.05rem; }
  .ctas { margin-top: 1.6rem; }
  .ctas .btn { margin-right: .6rem; }
</style>
