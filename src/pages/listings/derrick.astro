---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import TrademarkStatement from '../../components/TrademarkStatement.astro';
import { DERRICK_LISTINGS } from '../../data/listings.ts';
import { SITE } from '../../data/site.ts';

const listings = DERRICK_LISTINGS;
---
<BaseLayout title="Derrick's Listings — Derrick Garcia | Real Broker Ontario"
  description="Homes currently listed by Derrick Garcia and the team. See the full details and book a viewing.">
  <section class="head container">
    <p class="kicker">Listings</p>
    <h1>Derrick's listings.</h1>
  </section>
  <section class="container body">
    {listings.length > 0 ? (
      <>
        <div class="grid">
          {listings.map((l) => (
            <div class="listing-card-wrap reveal">
              <ListingCard listing={l} detailHref={`/listings/${l.id}`} />
            </div>
          ))}
        </div>
        <TrademarkStatement />
      </>
    ) : (
      <>
        <p class="empty">Derrick's active listings will appear here as soon as they hit the market.
          In the meantime, browse every active GTA listing or reach out — we'll send you what's
          coming up before it's listed.</p>
        <p class="ctas">
          <a class="btn" href="/listings">Browse all GTA listings</a>
          <a class="btn btn--ghost" href={SITE.listingsSearchUrl} target="_blank" rel="noopener noreferrer">Search realtor.ca ↗</a>
          <a class="btn btn--ghost" href={SITE.phoneHref}>Call {SITE.phoneDisplay}</a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>Email us</a>
        </p>
      </>
    )}
  </section>
</BaseLayout>
<style>
  .head { padding-block: clamp(2.5rem, 7vw, 4rem) 1rem; }
  .body { padding-bottom: var(--section-pad); }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .listing-card-wrap { display: flex; }
  .listing-card-wrap > :global(.listing-card) { flex: 1; }
  .empty { max-width: 56ch; font-size: 1.05rem; }
  .ctas { margin-top: 1.6rem; }
  .ctas .btn { margin: 0 .6rem .6rem 0; }
</style>
