# CREA DDF — Member Website Feed credentials (self-operated, "All Offices").
# Copy to .env (gitignored) for local listings fetch: `pnpm fetch:listings`.
# In CI these are GitHub Actions Secrets (same names) — see .github/workflows/deploy.yml.
#
# Public, non-secret endpoints/scope (safe defaults — fill the two secrets below):
CREA_DDF_TOKEN_URL=https://identity.crea.ca/connect/token
CREA_DDF_SCOPE=DDFApi_Read
CREA_DDF_API_BASE=https://ddfapi.realtor.ca

# Secret — obtain from the CREA DDF Dashboard (Member Website Feed → Destination credentials):
CREA_DDF_CLIENT_ID=
CREA_DDF_CLIENT_SECRET=
